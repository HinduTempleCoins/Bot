{
  "name": "van-kush-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for Temple of Van Kush using Gemini API",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "hello": "node hello.js",
    "test": "node --test tutorial/*.test.js welcomer/*.test.js watcher/*.test.js witness/*.test.mjs src/chain/*.test.js commands/*.test.js integrations/*.test.js cheetah/*.test.js store/*.test.js autovote/*.test.js signup/*.test.mjs engine/test/*.test.mjs pool/www/*.test.mjs pool/bridge/*.test.mjs site/*/*.test.mjs site/*/*/*.test.mjs spamtest/*.test.mjs",
    "autovote": "node autovote/server.js",
    "engine": "node engine/node.mjs",
    "engine:once": "node engine/node.mjs --once",
    "engine:serve": "node engine/node.mjs --serve",
    "preflight": "bash scripts/preflight.sh",
    "welcomer:once": "node welcomer/index.js --once",
    "welcomer:cron": "node welcomer/index.js --cron",
    "welcomer:live": "node welcomer/index.js --cron --broadcast",
    "watcher:once": "node watcher/index.js --once",
    "watcher:cron": "node watcher/index.js --cron",
    "watcher:dry": "node watcher/index.js --once --dry-run",
    "tutorial:once": "node tutorial/scheduler.js --once",
    "tutorial:cron": "node tutorial/scheduler.js --cron",
    "tutorial:live": "node tutorial/scheduler.js --cron --broadcast",
    "spamtest": "node spamtest/runner.mjs --count 50 --kind post",
    "spamtest:probe": "node spamtest/probe.mjs --account spambot1",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "trade": "node hive-trading-bot.js",
    "trade:dev": "node --watch hive-trading-bot.js",
    "scan-tokens": "node hive-token-scanner.js",
    "apis": "node integrations/free-apis.mjs smoke",
    "trade:forensics": "node integrations/tradebot-forensics.mjs",
    "trade:market": "node integrations/hive-engine-market.mjs",
    "trade:analyze": "node integrations/trade-analyzer.mjs",
    "trade:arb": "node integrations/arb-scanner.mjs",
    "trade:depth": "node integrations/market-depth.mjs",
    "trade:prices": "node integrations/price-oracle.mjs",
    "trade:timeline": "node integrations/timeline.mjs",
    "trade:chain": "node integrations/chain-explorer.mjs",
    "trade:digest": "node integrations/digest.mjs",
    "trade:publish": "node integrations/publish-feed.mjs",
    "trade:feed": "node integrations/digest.mjs && node integrations/trade-sanitizer.mjs && node integrations/publish-feed.mjs"
  },
  "keywords": [
    "discord",
    "bot",
    "gemini",
    "van-kush"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "0.21.0",
    "@hiveio/dhive": "1.3.2",
    "@huggingface/transformers": "4.2.0",
    "axios": "1.17.0",
    "ccxt": "4.5.56",
    "discord.js": "14.25.1",
    "dotenv": "16.6.1",
    "jimp": "0.22.12",
    "node-cache": "5.1.2",
    "node-cron": "3.0.3",
    "ws": "8.18.3",
    "wtf_wikipedia": "10.4.1",
    "youtube-transcript": "1.2.1"
  },
  "overrides": {
    "undici": "^6.24.1"
  }
}