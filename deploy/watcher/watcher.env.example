# watcher.env — environment for the Hathor sensitive-op watcher (watcher/index.js).
# Copy to the operator's private env path on the box and substitute the
# __PLACEHOLDER__ values. Ships with placeholders ONLY — no real hostnames/paths
# in the repo. There are NO keys here that can sign: the watcher is strictly
# READ-ONLY (no WIF, no active key, no posting key — it never broadcasts).
# The Telegram bot token + Resend API key below are ALERT-DELIVERY creds, not
# chain keys; they are optional (the file sink always works without them).

# --- chain (read-only) ------------------------------------------------------
# Local MELEK testnet RPC. The node on the box serves this. Read-only JSON-RPC.
MELEK_RPC_URL=http://127.0.0.1:8090
# Optional — dhive infers these from the RPC, but pin them for the testnet to be safe.
# MELEK_CHAIN_ID=__CHAIN_ID__
# MELEK_ADDRESS_PREFIX=TST

# Account to watch. Defaults to 'hathor' if unset.
HATHOR_ACCOUNT=hathor

# --- watcher behaviour ------------------------------------------------------
# Cron expr is only used by the module's own --cron mode; under systemd the
# .timer drives the cadence and runs --once, so this is ignored there. Left for
# reference / ad-hoc `node watcher/index.js --cron` runs.
# WATCHER_CRON=* * * * *

# How many history entries to fetch per tick. 100 covers normal throughput on a
# witness account between 1-min ticks with wide margin.
# WATCHER_HISTORY_LIMIT=100

# State file (history cursor + per-event alert de-dup). Put it in the writable
# DATA_DIR the unit grants (ReadWritePaths), NOT in the repo checkout.
WATCHER_STATE_FILE=__DATA_DIR__/watcher.state.json

# Always-on JSONL alert log (the file sink). Also in DATA_DIR.
WATCHER_LOG_FILE=__DATA_DIR__/alerts.jsonl

# --- alert-delivery sinks (optional) ---------------------------------------
# The file sink (WATCHER_LOG_FILE above) is always on and needs nothing. To also
# get Telegram and/or email alerts, set the SAME delivery vars documented in the
# repo root `.env.example` ("Telegram sink" / "Email sink via Resend" sections):
#   - the Telegram bot token + chat id pair, and/or
#   - the Resend API key + ALERT_EMAIL_FROM + ALERT_EMAIL_TO.
# These are alert-DELIVERY creds, NOT chain keys. Set them here (in this private
# env file on the box), never in the repo. Names are read by watcher/config.js.
