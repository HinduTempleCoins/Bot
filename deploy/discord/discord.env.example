# discord.env.example — private env for the Van Kush Family Discord bot (index.js).
# Copy to a private path on the server (e.g. /srv/bot/discord.env), fill it in, chmod 600.
# NEVER commit the filled-in file. The real values for the Discord/AI keys are the ones we pulled
# out of Railway — they live in .local/railway-bot.env (gitignored) on the operator side.
#
# This file holds NO chain WIF. The Hathor key is never here. (BRIEF.md §7.)

# ── Discord + AI (required to run the bot at all) ──────────────────────────────────────────────
DISCORD_TOKEN=
GEMINI_API_KEY=

# ── Optional bot features (leave blank to disable that feature) ────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
YOUTUBE_API_KEY=
PRICE_ALERT_CHANNEL_ID=

# ── /tip command — how this bot reaches the MELEK chain ────────────────────────────────────────
# The bot holds NO key. There are two modes; pick ONE.
#
# (A) REMOTE (default for a bot on a NON-chain server, e.g. Azure/Google): the bot POSTs the tip
#     to a small signer endpoint on the CHAIN host, which does the JIT-vault sign +
#     broadcast. Set both of these to the endpoint's URL + its shared secret:
MELEK_TIP_BROADCAST_URL=
MELEK_TIP_SHARED_SECRET=
#
# (B) LOCAL (only if this unit runs ON the chain host itself): the tip CLI fetches the key from the
#     local vault and broadcasts to the local node. Leave the two REMOTE vars above blank and set:
# MELEK_RPC=http://127.0.0.1:8090
# MELEK_VAULT_CLI=/opt/melek-bot/vault.mjs
# MELEK_TIP_LEDGER=/srv/bot/discord-tip-ledger.json
#
# Default tip token symbol (engine token Hathor tips):
MELEK_TIP_SYMBOL=MANNA
