# .env.template — environment for self-hosted n8n (queue #109).
#
# Copy to `.env` NEXT TO docker-compose.yml on the operator box and substitute every
# __PLACEHOLDER__. This file ships with placeholders ONLY — no real hostnames, domains,
# or secrets live in the repo. The real .env is gitignored (it holds secrets).
#
#   cp .env.template .env  &&  edit .env  &&  docker compose up -d
#
# Generate the two secrets BEFORE first start (see RUNBOOK.md "First start"):
#   N8N_ENCRYPTION_KEY:        openssl rand -hex 32
#   N8N_BASIC_AUTH_PASSWORD:   openssl rand -base64 24    (or a long passphrase)

# --- HTTP basic auth (front gate before the editor login) ---
N8N_BASIC_AUTH_USER=__BASIC_AUTH_USER__
N8N_BASIC_AUTH_PASSWORD=__BASIC_AUTH_PASSWORD__

# --- Public addressing (must match the Caddy __DOMAIN__) ---
# Bare hostname Caddy serves, e.g. n8n.example.tld  (no scheme, no path).
N8N_HOST=__DOMAIN__
# Full https base URL the outside world uses to reach n8n (through Caddy).
N8N_EDITOR_BASE_URL=https://__DOMAIN__/
# Base URL used to build webhook/callback URLs handed to external services.
# Normally identical to the editor base URL.
WEBHOOK_URL=https://__DOMAIN__/

# --- Locale / time (IANA tz, drives cron + Schedule nodes) ---
GENERIC_TIMEZONE=__TIMEZONE__
# e.g. America/Chicago  (the operator/CST default) — or UTC

# --- Data at rest: credentials encryption key. ---
# MUST stay constant across restarts/upgrades, or stored credentials become unreadable.
# 64 hex chars from: openssl rand -hex 32
# Back this up with the volume (RUNBOOK "Backup"). Losing it = re-entering every credential.
N8N_ENCRYPTION_KEY=__ENCRYPTION_KEY_64_HEX__
