# cheetah.env — environment for the CheetahAdvanced read-only testnet watcher.
# Copy to the operator's private env path on the box and substitute the
# __PLACEHOLDER__ values. Ships with placeholders ONLY — no real hostnames/paths
# in the repo. There are NO keys here: the watcher is read-only (no WIF, no
# posting key, no MELEK-Signer token — it never broadcasts).

# Local MELEK testnet RPC (read-only JSON-RPC). The node on the box serves this.
MELEK_RPC_URL=http://127.0.0.1:8090

# Shared multi-bot store data dir (cheetah.findings live here; Hathor reads them).
CHEETAH_STORE_ROOT=__DATA_DIR__

# Where the test-report surface (index.html + report.json) is written. Point this
# at the alpha.melek.salon static root's /cheetah subdir so the run is visible.
CHEETAH_REPORT_DIR=__REPORT_DIR__

# Poll period for --watch mode, in milliseconds (default 300000 = 5 min).
# CHEETAH_POLL_INTERVAL=300000

# Posts pulled per poll (default 20).
# CHEETAH_ALPHA_LIMIT=20

# Similarity threshold for a MATCH finding (default 0.5). Tune up if too chatty.
# CHEETAH_SIMILARITY_THRESHOLD=0.5

# Web search backend for off-chain attribution. Leave 'none' for testnet
# (on-chain cross-reference only); a key-bearing backend is an operator decision.
# CHEETAH_WEB_SEARCH=none
