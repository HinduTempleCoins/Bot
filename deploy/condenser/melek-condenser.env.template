# MELEK Condenser — environment template (alpha.melek.salon)
# ---------------------------------------------------------------------------
# Copy to the host as the systemd EnvironmentFile (see RUNBOOK.md), fill every
# __PLACEHOLDER__, then `chmod 600`. Public values are pre-filled. Host-specific
# / secret values are __PLACEHOLDER__ and must be set on the box, never here.
#
# The condenser is the BLURT Condenser fork; it consumes the SDC_* names defined
# in melek-condenser/config/custom-environment-variables.json. Any value NOT set
# here falls back to melek-condenser/config/{default,production}.json — which
# already carry the MELEK testnet chain_id + address_prefix (baked at build time).
# The four variables that MUST be set for a correct, secure boot are marked
# REQUIRED below; the rest are documented for completeness.
# ===========================================================================

# --- Node runtime (REQUIRED) ----------------------------------------------
NODE_ENV=production
# Node >=17 needs the legacy OpenSSL provider for this build's crypto bindings.
NODE_OPTIONS=--openssl-legacy-provider
# Codespaces/CI set BROWSER to a helper path that trips the SSR guard. Keep empty.
BROWSER=
# Port the Koa SSR server binds. Caddy reverse-proxies to this on 127.0.0.1.
PORT=8085

# --- Chain RPC (REQUIRED) -------------------------------------------------
# Point BOTH at the local MELEK testnet node on this same box. The SSR server
# (SERVER) and the browser bundle (CLIENT) both hit it. Because the browser
# also uses CLIENT, if the testnet RPC is not reachable from end-user browsers
# you must instead front it through Caddy (e.g. https://alpha.melek.salon/rpc)
# and set CLIENT to that public URL — see RUNBOOK "RPC exposure decision".
SDC_SERVER_BLURTD_URL=http://127.0.0.1:8090
SDC_CLIENT_BLURTD_URL=http://127.0.0.1:8090
# Use the appbase (condenser_api) JSON-RPC shape. true for this Steem/Blurt fork.
SDC_USE_APPBASE=true
# Failover list (space-separated). Single local node for the testnet.
SDC_ALT_API_ENDPOINTS=http://127.0.0.1:8090

# --- Chain identity (REQUIRED to match the testnet) -----------------------
# MELEK testnet chain id (starts 18dcf0…) and Graphene address prefix.
# These ALSO live in config/default.json (baked at build); set them in env too
# so a config drift can't silently point the UI at the wrong chain.
SDC_CHAIN_ID=18dcf0a285365fc58b71f18b3d3fec954aa0c141c44e4e5cb4cf777b9eab274e
SDC_ADDRESS_PREFIX=TST

# --- Session crypto (REQUIRED, host-secret) -------------------------------
# Koa session encryption key. MUST be >=32 bytes. Generate once on the box:
#   openssl rand -hex 32
# Keep STABLE across restarts or all sessions are invalidated. Never commit.
SDC_SESSION_SECRETKEY=__PLACEHOLDER_OPENSSL_RAND_HEX_32__
# Cookie names (public, stable).
SDC_SESSION_COOKIE_KEY=melek-alpha

# --- Site identity (public) -----------------------------------------------
SDC_SITE_DOMAIN=alpha.melek.salon

# --- Optional / off by default --------------------------------------------
# Read-only mode disables broadcasting from the UI (leave false; users sign in-browser).
SDC_READONLY_MODE=false
# Image upload proxy — leave empty unless an uploader is deployed.
SDC_UPLOAD_IMAGE_URL=
SDC_IMAGE_PROXY_PREFIX=
# Email (magic-link) — only the wallet flow needs these; condenser leaves blank.
SDC_SENDGRID_API_KEY=
SDC_SENDGRID_FROM=
# Analytics / ads / captcha — all off for the alpha testnet.
SDC_GOOGLE_ANALYTICS_ID=
SDC_FACEBOOK_APP_ID=
SDC_RECAPTCHA_SITE_KEY=
SDC_RECAPTCHA_SECRET_KEY=
SDC_NOTIFY_GCM_KEY=
SDC_ENABLE_COOKIE_CONSENT=
SDC_COOKIE_CONSENT_KEY=
# Telesign / Twilio SMS — NOT used (BRIEF.md §6: email only, no SMS). Leave blank.
SDC_TELESIGN_CUSTOMER_ID=
SDC_TELESIGN_API_KEY=
SDC_TWILIO_ACCOUNT_SID=
SDC_TWILIO_AUTH_TOKEN=

# --- Conveyor (account metadata service) — NOT deployed -------------------
# The condenser only calls conveyor if a username is set. Leave blank to disable.
CONVEYOR_USERNAME=
CONVEYOR_POSTING_WIF=
