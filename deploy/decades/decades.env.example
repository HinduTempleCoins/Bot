# decades.env — environment for the decades-brain brief/annal pipeline.
# Copy to the operator's private env path on Server A and substitute the __PLACEHOLDER__ values.
# This file ships with placeholders ONLY — no real hostnames or paths live in the repo.

# Directory of brief/annal files to route+dedup (*.json | *.md | *.txt; results written as <id>.decades.json).
DECADES_QUEUE_DIR=__DATA_DIR__/brief-queue

# The existing corpus to dedup against: JSON array of { "id", "text", "route"?, "vec"? }.
DECADES_STORE_FILE=__DATA_DIR__/decades/store.json

# OPTIONAL known-topics file for routing: JSON array of { "label", "examples": ["..."] }.
# If omitted, items route to 'unrouted' (still deduped). Recommended once topics are known.
DECADES_ROUTES_FILE=__DATA_DIR__/decades/routes.json

# Where result JSONs land (default: alongside the queue items if unset).
DECADES_OUT_DIR=__DATA_DIR__/decades/results

# OPTIONAL tuning (defaults: dup 0.92, route 0.45).
# DECADES_DUP_THRESHOLD=0.92
# DECADES_ROUTE_THRESHOLD=0.45

# OPTIONAL dense embedder module path (relative to deploy/decades/), e.g. the parallel
# MiniLM embedder once it lands: ../../integrations/minilm-embedder.mjs
# Must export embed(text) -> number[]. Absent → the zero-dependency word-bag path (1-core safe).
# DECADES_EMBEDDER=../../integrations/minilm-embedder.mjs
