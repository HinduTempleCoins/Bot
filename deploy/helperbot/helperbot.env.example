# Hathor helper bot env (copy to the private env file; values below are the SAFE launch defaults).
HELPERBOT_ENABLED=1
# MELEK RPC failover order — local node first on the chain host, then the other mainnet nodes.
MELEK_RPC_NODES=https://melek.salon/rpc,https://wallet.melek.salon/rpc
HELPERBOT_HEALTH_PORT=8787
HELPERBOT_DATA_DIR=/var/lib/hathor-helper
# Tips (PIZZA pattern). Stay SIMULATED until the operator sets the treasury + LIVE + a signer.
HELPERBOT_TIP_TOKEN=PRANA
HELPERBOT_TIP_AMOUNT=0.1
HELPERBOT_TIP_TIERS=1:1,10:3,100:10,1000:25
HELPERBOT_TIP_DAILY_CAP=25
HELPERBOT_TIP_TREASURY=
HELPERBOT_TIP_LIVE=0
# Faucet: dry-run until switched on.
HELPERBOT_FAUCET_LIVE=0
HELPERBOT_FAUCET_DAILY_CAP=50
HELPERBOT_FAUCET_MIN_AGE_DAYS=7
# AI via Hathor's fleet queue on PRANA (off; the existing path is used).
HATHOR_FLEETQ=0
HATHOR_FLEETQ_URL=
HATHOR_FLEETQ_TOKEN=
# Discord invite used in replies (current one EXPIRES 2026-11-14 — replace with a permanent invite).
HELPERBOT_DISCORD_INVITE=https://discord.gg/6pyjAv2Qu
