# LLM backend — OPTIONAL. Generation runs KEYLESS by default: with no key set, the article
# generator routes through integrations/llm-router.mjs, whose final rung is the keyless Pollinations
# text model. Set any ONE of these to use a (better) keyed provider instead; Gemini stays primary
# when its key is present, the rest are tried in ladder order, keyless Pollinations is the backstop.
#   GEMINI_API_KEY      Gemini (free tier 1,500 req/day) — primary when set
#   OPENROUTER_API_KEY  OpenRouter (free Llama 4 model)
#   GITHUB_TOKEN        GitHub Models (gpt-4o)
#   GROQ_API_KEY        Groq (llama-3.3-70b)
# No key at all => keyless Pollinations. Zero operator key required.
GEMINI_API_KEY=

# MediaWiki Configuration
WIKI_URL=http://your-wiki-host/wiki

# Wiki Bot Account (for editing - create a bot account in MediaWiki)
WIKI_BOT_USERNAME=
WIKI_BOT_PASSWORD=

# Knowledge Base Path (defaults to ../knowledge if not set)
KNOWLEDGE_BASE_PATH=
