{
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "",
        "logBaseDirectory": "/app/logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": false
    },
    "notifications": {
        "enabled": false,
        "admin": {
            "enabled": false,
            "emailAddress": "",
            "notifyBlockFound": false
        }
    },
    "persistence": {
        "postgres": {
            "host": "melek-mc-postgres",
            "port": 5432,
            "user": "miningcore",
            "password": "__PG_PASSWORD__",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "shareRecoveryFile": "/app/recovered-shares.txt"
    },
    "api": {
        "enabled": true,
        "listenAddress": "0.0.0.0",
        "port": 4000,
        "metricsIpWhitelist": [],
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [
        {
            "id": "xmr-stagenet",
            "enabled": true,
            "coin": "monero",
            "address": "57kYk4iMy9SCMyeRctNW6QUpCVKnRp1682BiYnxUqMVDjhAVABfQJbUTC5oTvfRruNVVxqGK6MEz3QoQLnV2NPGxBArv9Kz",
            "extra": {
                "randomXRealm": "monero"
            },
            "//rewardRecipients": "POOL FEE -> HATHOR. The pool fee is taken via Miningcore rewardRecipients: each entry is {address, percentage}; that percentage of every block reward is paid to that address ON THIS COIN'S CHAIN (there is no global fee wallet — each pool pays in its own coin). The recipient MUST be a Hathor-controlled payout address — NOT PRANA (PRANA is the pool; a 'fee to PRANA' is meaningless) and never a third-party pool-software dev cut. Left empty here because the live per-coin address is an operator/treasury value substituted on the box, not committed (zero-WIF / private-by-default). See .local/POOL_FEE_ROUTING_RUNBOOK.md for the value to set on each pool at deploy. This off-chain pool fee is separate from any PRANA chain-level reward routing.",
            "rewardRecipients": [],
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": {
                "enabled": true,
                "time": 600,
                "invalidPercent": 50,
                "checkThreshold": 50
            },
            "ports": {
                "4446": {
                    "//": "BROWSER port — fixed, very low difficulty for the in-page WASM RandomX miner (~8-10 H/s/thread desktop, a few H/s on phones). No varDiff so weak browser miners still land shares in seconds; the WS->stratum bridge (melek-pool-bridge) targets THIS port. Shares are real (pool re-validates PoW). Not for native miners — they use 4444/4445.",
                    "listenAddress": "0.0.0.0",
                    "difficulty": 16,
                    "name": "Browser / WASM (RandomX, stagenet) — via /ws bridge"
                },
                "4444": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 1000,
                    "name": "CPU / Low-end (RandomX, stagenet)",
                    "varDiff": {
                        "minDiff": 100,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                },
                "4445": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 25000,
                    "name": "High-End (RandomX, stagenet)",
                    "varDiff": {
                        "minDiff": 10000,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                }
            },
            "daemons": [
                {
                    "host": "melek-mc-monerod",
                    "port": 38081,
                    "user": "",
                    "password": ""
                },
                {
                    "host": "melek-wallet-rpc",
                    "port": 38082,
                    "user": "",
                    "password": "",
                    "category": "wallet"
                }
            ],
            "paymentProcessing": {
                "enabled": true,
                "minimumPayment": 0.25,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": {
                    "factor": 2.0
                }
            }
        },
        {
            "//": "Monero MAINNET — configured but DISABLED. The box cannot carry a pruned mainnet node (~80GB+) alongside the stagenet daemon, Mordor, and Postgres (47G free at provision). To enable: (1) provision a synced mainnet monerod as melek-mc-monerod-main on melek-pool-net (pure-P2P, --prune-blockchain), (2) set this pool's address to a real MAINNET pool wallet (mainnet-value key, NEVER on this box — operator-held signer), (3) set \"enabled\": true, (4) systemctl restart melek-miningcore. Until then xmr-stagenet is the live RandomX proof and the menu shows 'Monero (mainnet) — coming online'.",
            "id": "xmr-mainnet",
            "enabled": false,
            "coin": "monero",
            "address": "__MONERO_MAINNET_POOL_ADDRESS__",
            "extra": {
                "randomXRealm": "monero"
            },
            "//rewardRecipients": "POOL FEE -> HATHOR (a Hathor-controlled mainnet payout address on this coin's chain). Set when this mainnet pool is enabled; the mainnet-value key never lives on the box (operator signer). See .local/POOL_FEE_ROUTING_RUNBOOK.md.",
            "rewardRecipients": [],
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": {
                "enabled": true,
                "time": 600,
                "invalidPercent": 50,
                "checkThreshold": 50
            },
            "ports": {
                "4454": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 5000,
                    "name": "CPU / Low-end (RandomX, mainnet)",
                    "varDiff": {
                        "minDiff": 1000,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                },
                "4455": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 100000,
                    "name": "High-End (RandomX, mainnet)",
                    "varDiff": {
                        "minDiff": 50000,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30
                    }
                }
            },
            "daemons": [
                {
                    "host": "melek-mc-monerod-main",
                    "port": 18081,
                    "user": "",
                    "password": ""
                },
                {
                    "host": "melek-wallet-rpc-main",
                    "port": 18082,
