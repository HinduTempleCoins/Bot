# Repo-level npm policy. Enforced for every install, every user of this repo.
#
# ignore-scripts=true blocks postinstall scripts from running during
# `npm install` / `npm ci`. This is the single most effective defense against
# the event-stream-class crypto-drainer npm supply-chain attack pattern
# (see SECURITY.md §4a). If a dep needs a postinstall script for legitimate
# reasons (rare for this project), audit it and run it manually with
# `npm rebuild <pkg>` after the install completes.
#
# save-exact=true means `npm install <pkg>` records the exact installed
# version in package.json with no ^/~ prefix. Pairs with the pinned deps in
# package.json (see SECURITY.md §4d).
#
# engine-strict=true makes npm refuse to install if the Node version on the
# host doesn't satisfy the engines.node range in package.json. Reproducibility
# across operator hosts.
ignore-scripts=true
save-exact=true
engine-strict=true
