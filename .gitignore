# Environment variables
.env

# Operator-only local notes — Stage briefs, VM credentials,
# anything that should never reach a public commit.
.local/

# Tutorial runtime state (per-deployment, never committed)
tutorial/.state.json
tutorial/.state.json.tmp

# Welcomer runtime state (per-deployment, never committed)
welcomer/.state.json
welcomer/.state.json.tmp

# Watcher runtime state + alert log (per-deployment, never committed)
watcher/.state.json
watcher/.state.json.tmp
watcher/alerts.jsonl

# Rate-limiter runtime state (per-deployment, never committed)
integrations/.rate-limit-state.json
integrations/.rate-limit-state.json.tmp

# Moderation flag/report store (per-deployment runtime queue, never committed)
integrations/.moderation-flags.jsonl

# Datasets — operator's private knowledge JSONLs stay gitignored.
# Openly-licensed reference corpus subdirs (cookbooks, hive-devportal,
# chain-libs, crypto-protocols, crypto-books, ml-courses, ml-libs)
# are public reference material the AIs draw on — committed.
datasets/*
!datasets/README.md
!datasets/cookbooks/
!datasets/cookbooks/**
!datasets/hive-devportal/
!datasets/hive-devportal/**
!datasets/chain-libs/
!datasets/chain-libs/**
!datasets/crypto-protocols/
!datasets/crypto-protocols/**
!datasets/crypto-books/
!datasets/crypto-books/**
!datasets/ml-courses/
!datasets/ml-courses/**
!datasets/ml-libs/
!datasets/ml-libs/**
!datasets/security-corpus/
!datasets/security-corpus/**
!datasets/security-corpus/owasp-llm-top10/
!datasets/security-corpus/owasp-llm-top10/**
!datasets/security-corpus/mitre-atlas/
!datasets/security-corpus/mitre-atlas/**
*.jsonl

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

__pycache__/
*.pyc

# Private resident-AI / server infrastructure — never public (recon surface)
infra/
cheetah/.image-hashes.json
.local/wallet-config.json
store/.data/
library-of-ashurbanipal-bot/data/indexnow-key.txt
data/indexnow-key.txt

integrations/soapbox/data/indexnow-key.txt
site/soapbox/data/

# Runtime fact-check / KB-flag output (per-deployment, never committed)
data/

# diag-to-tasks bare-run output (box uses DIAG_TASKS_PATH instead)
integrations/.diag-tasks/

# Built semantic library vector cache (rebuilt on the box; not source)
.library-index/

# karma runtime store (forkable but rebuilt; not source)
karma/data/*.json
