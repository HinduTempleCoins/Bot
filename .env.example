# Bot — Environment Variables Template
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: never commit .env (it is gitignored). Never paste real keys into
# this file (.env.example IS committed). ZERO WIF ON THIS HOST, by construction:
# the Bot never holds a chain private key. All broadcasts go through MELEK-Signer
# (separate hardened service) authenticated by a scoped, revocable bearer token.
# See MELEK_SIGNER.md.

# ========================================
# MELEK CHAIN — HATHOR ACCOUNT  (Phase 1+)
# ========================================
# The on-chain account name the Bot operates. Lowercase. Default 'hathor'.
HATHOR_ACCOUNT=hathor

# Broadcast path (MELEK_SIGNER.md §6). The Bot holds NO private keys — not
# posting, not active, and never owner (offline). Signing happens inside the
# MELEK-Signer service; this Bot sends it operations with a scoped bearer
# token. The token is revocable and op-scoped (a leaked token can at worst
# request in-policy ops; it can never exfiltrate a key).
MELEK_SIGNER_URL=
MELEK_SIGNER_TOKEN=

# Chain network parameters. The chain ID and address prefix come from
# HinduTempleCoins/melek-chain (see its config.hpp). Leave blank here; fill in
# .env once the values are pinned by the chain side.
MELEK_NETWORK=testnet
MELEK_RPC_URL=
MELEK_CHAIN_ID=
MELEK_ADDRESS_PREFIX=

# Informational price feed (witness/feed-publisher.js). MELEK has no internal
# stablecoin — this feed is informational only, advertising the Witness's view
# of MELEK's exchange rate against an external reference.
MELEK_FEED_BASE=1.000 MELEK
MELEK_FEED_QUOTE=
FEED_CRON=0 * * * *

# Witness registration (witness/register.js). Used once at bootstrap, then
# whenever signing key / url / props need updating. Public-facing values only;
# no private keys here.
HATHOR_WITNESS_URL=
HATHOR_BLOCK_SIGNING_PUBKEY=
HATHOR_ACCOUNT_CREATION_FEE=0.000 MELEK
HATHOR_MAXIMUM_BLOCK_SIZE=131072

# ========================================
# WELCOMER  (welcomer/index.js)
# ========================================
# The welcomer watches the chain for new accounts and posts a single
# comment on the canonical Welcome / Tutorial Program post, mentioning
# the new user by handle. The mention generates their notification.
#
# Chain config: by default the welcomer uses MELEK_RPC_URL / MELEK_CHAIN_ID /
# MELEK_ADDRESS_PREFIX above. To point at a different chain (e.g. Blurt for
# observation-only --dry-run testing), set CHAIN_* below — they take
# precedence over the MELEK_* values.
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_ADDRESS_PREFIX=

# Bot account for welcomer broadcasts. Defaults to HATHOR_ACCOUNT above if
# unset. Override for testing under a different bot identity. Broadcasts go
# through MELEK-Signer (MELEK_SIGNER_URL/TOKEN above) — no key here.
BOT_ACCOUNT=

# The canonical Welcome / Tutorial Program post — REQUIRED. Admin task to
# author and publish before running the welcomer; the bot reads from it but
# does not author it. Welcomer fails loudly at startup if these don't resolve.
WELCOME_POST_AUTHOR=
WELCOME_POST_PERMLINK=

# URL the welcome comment points new users at. Phase 2 placeholder: BRIEF.md
# on GitHub. Swap to an on-chain tutorial-index permlink once Lesson 1 ships.
TUTORIAL_LINK=

# Accounts the welcomer should ignore (comma- or space-separated). Defaults
# to BOT_ACCOUNT only. Add founding witnesses + treasury accounts here.
SKIP_ACCOUNTS=

# Welcomer cron schedule (--cron mode only). Default every 2 minutes.
WELCOMER_CRON=*/2 * * * *

# Max blocks scanned per tick. At 4s blocks, 50 ≈ 3.3 min of chain time.
WELCOMER_BATCH_BLOCKS=50

# Where to persist the discovery cursor + welcomed-set. Default
# welcomer/.state.json (gitignored). Set to an absolute path for production.
LAST_BLOCK_FILE=

# ========================================
# WATCHER  (watcher/index.js)
# ========================================
# Out-of-band alerter for sensitive on-chain ops by the bot account: outbound
# transfers, account_update (key rotation), withdraw_vesting (power-down init),
# delegate_vesting_shares, witness_update. Read-only — never touches keys.
# Per SECURITY.md §4d: any transfer pings the operator within seconds; if it
# wasn't you, you have minutes to act with the offline owner key.
#
# Chain config defaults to CHAIN_RPC_URL / MELEK_RPC_URL above; bot account
# defaults to BOT_ACCOUNT / HATHOR_ACCOUNT above.

# Watcher cron schedule (--cron mode only). Default every minute.
WATCHER_CRON=* * * * *

# Account-history entries fetched per tick. 100 covers a busy minute of
# activity comfortably; raise if throughput climbs.
WATCHER_HISTORY_LIMIT=100

# Where to persist cursor + alerted-set. Default watcher/.state.json
# (gitignored). Set to an absolute path for production.
WATCHER_STATE_FILE=

# Always-on JSONL alert log. Even when Telegram / email are misconfigured,
# alerts still land here for `tail -f` review. Default watcher/alerts.jsonl
# (gitignored — never committed; rotates by operator policy, not by us).
WATCHER_LOG_FILE=

# --- Telegram sink (optional but recommended) ----------------------
# Setup:
#   1. Talk to @BotFather on Telegram, /newbot, save the token below.
#   2. Send a message to your new bot (or add it to a private group).
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email sink via Resend (optional) ------------------------------
# Setup:
#   1. Create a Resend account, verify the sending domain.
#   2. Generate an API key, save as RESEND_API_KEY.
#   3. ALERT_EMAIL_FROM must be on the verified domain.
#   4. ALERT_EMAIL_TO may be a single address or comma-separated list.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ========================================
# DISCORD BOT  (legacy van-kush-discord-bot path, separate from MELEK)
# ========================================
DISCORD_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_application_id
HIVE_DISCORD_WEBHOOK=your_discord_webhook_url

# ========================================
# AI APIS (Choose one or use both as backup)
# ========================================

# OpenRouter AI (FREE Llama 4 Maverick - RECOMMENDED)
# Get free key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free

# Google / Gemini AI (Backup)
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ========================================
# HIVE BLOCKCHAIN
# ========================================
# ZERO-WIF RULE: no Hive private keys on this host either (the angelicalist
# key leak, commit b4c4e55, is the standing lesson). Read-only modules need
# only the username. Anything that must sign uses the signer/vault boundary.
HIVE_USERNAME=your_hive_account

# ========================================
# VAN KUSH MARKET MAKER
# ========================================
# DRY_RUN: Set to 'false' to enable live trading (BE CAREFUL!)
MM_DRY_RUN=true

# Price nudging strategy
MM_NUDGE_INCREMENT=0.00000010
MM_MAX_NUDGES_DAY=10
MM_NUDGE_INTERVAL=3600000  # 1 hour in milliseconds

# Safety limits
MM_MAX_JUMP=0.05  # Max 5% price jump per nudge
MM_SELL_TRIGGER=0.10  # 10%+ is considered sell trigger

# Wall sizes (in HIVE)
MM_BUY_WALL_SIZE=50
MM_SUPPORT_SIZE=25

# Whale tracking threshold
MM_MIN_WHALE=100000  # 100k tokens = whale

# Optional: Discord webhook for market maker notifications
MM_DISCORD_WEBHOOK=your_discord_webhook_url

# ========================================
# HIVE-ENGINE TRADING BOT
# ========================================
HIVE_BOT_DRY_RUN=true
HIVE_BOT_MAX_TRADE_SIZE=100
HIVE_BOT_STOP_LOSS=0.05  # 5%
HIVE_BOT_TAKE_PROFIT=0.15  # 15%

# BLURT Preference (Tier 2 strategic token - see TRADING_STRATEGY.md)
# Apply multiplier to BLURT profit calculations
# Example: 5% BLURT profit treated as 7% (5% * 1.4 = 7%)
# Makes bot prefer BLURT over equally profitable alternatives
# Does NOT override VKBT/CURE priority (Tier 1)
BLURT_PREFERENCE_MULTIPLIER=1.4

# ========================================
# OPTIONAL: GOOGLE MAPS
# ========================================
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ========================================
# RESIDENT-AI LLM BACKENDS (briefd / annal-writer / code-walker)
# ========================================
# The resident AI on the resident-AI host (and tiny-LLM on the tiny-LLM host) can route LLM calls
# to multiple backends. Default is local Ollama; setting LLM_BACKEND
# switches to a free-tier API for higher quality. Fallback chain keeps
# the system running if a backend is rate-limited or down.
#
# CRITICAL: keys live in env on the box (briefd.env or shell), NEVER in
# code. gitleaks (.gitleaks.toml + Actions workflow) blocks any commit
# that contains a literal API key.

# Which backend to use first.
# Options: ollama (local, default) | gemini | groq | deepseek | openrouter | cerebras
LLM_BACKEND=ollama
LLM_FALLBACK_BACKEND=ollama

# Google Gemini (free tier: 1500 req/day for Gemini 2.0 Flash).
# Sign up at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY already declared above; reused here.
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier: 30 RPM). Excellent for code review.
# Sign up at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek (paid but very cheap; free credits via signup sometimes).
# Sign up at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (aggregator; has some free models incl. DeepSeek-V3 free).
# OPENROUTER_API_KEY already declared above; reused.
# OPENROUTER_MODEL already declared above (default: deepseek/deepseek-chat).

# Cerebras (free tier: 30 RPM, fast LPU inference).
# Sign up at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
