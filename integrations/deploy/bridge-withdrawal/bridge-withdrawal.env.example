# bridge-withdrawal.env.example — template for the PRANA -> MELEK redeem/exit leg.
# Copy to /root/Bot/creds/bridge-withdrawal.env on the custody host and fill in the real values.
# This file carries NO SECRET (the custody master comes from the systemd credential mount). Keep the
# real envfile OFF the public repo (it lives under creds/, gitignored on the host).

# --- PRANA (EVM) side: where GrapheneWithdrawal events are read from --------
PRANA_RPC_URL=https://rpc.prana.<your-host>
# GrapheneDepositBridge (PRANA mainnet). Public on-chain address (from PRANA_MAINNET_ADDRESSES.md).
GRAPHENE_BRIDGE_ADDRESS=0xf8245a4c9A8af47760C45D8393A74Ea8EEF1E505
# Only release for the native tokenId = keccak256("MELEK"). Any other wrapper is engine-side, skipped.
BRIDGE_NATIVE_TOKEN_ID=0x5a212ca60cafcdb5cfc9e9346ad12c4cccef6de33ea38bffbac8e3fd9091aa24
# Deep confirmation depth on PRANA before a release (young PoW can reorg). 12 is the runner default.
CONFIRMATIONS=12
# How far back to scan for withdrawal logs each restart.
WITHDRAWAL_LOOKBACK=5000

# --- MELEK (Graphene) side: where native MELEK is released FROM -------------
# Prefer the local MELEK node; the daemon reads AND broadcasts here.
MELEK_RPC_URL=http://127.0.0.1:8090
# The funded K-of-N custody account. NOTE: the 1-MELEK `wmelek-bridge` stub is NOT a real backing
# account — set this to the properly funded/locked custody account before enabling releases.
MELEK_BRIDGE_CUSTODY=wmelek-bridge
# Native symbol: MELEK on mainnet, TESTS on the testnet.
MELEK_NATIVE_SYMBOL=MELEK
# Graphene address prefix: MELEK on mainnet, TST on the testnet.
MELEK_ADDRESS_PREFIX=MELEK
# The MELEK chain id (32-byte hex). Fill from the running node's get_config / get_version.
MELEK_CHAIN_ID=<melek-mainnet-chain-id-hex>

# --- custody key (JIT-derived; NEVER a WIF on disk) ------------------------
# Points at the systemd LoadCredentialEncrypted mount. The daemon derives the active key JIT from
# this master (PrivateKey.fromLogin) and never logs it. See the .service file for the encrypt step.
MELEK_BRIDGE_CUSTODY_MASTER=%d/bridge-withdrawal-master

# Poll interval (ms). Minimum enforced at 10000.
TICK_MS=60000
